# Копирайте на .env и попълнете. Никога не commit-вайте .env.

# --- Open WebUI (OpenAI-съвместим endpoint) ---
OPENWEBUI_BASE_URL=https://chat.velocity.online/api/v1
OPENWEBUI_API_KEY=

# --- Модели по роля ---
# Потвърдени от потребителя 2026-08-10. Планер и Критик СЪЗНАТЕЛНО ползват същия модел
# (виж agent-bootstrap-prompt.md) — разликата между ролите е в промпта, не в модела.
MODEL_PLANNER=velocity/Qwen3.6-35B-A3B
MODEL_WRITER=m3.m3/qwen3.5-397b-a17b
MODEL_MEDIA=m2.m2/qwen3.6-35b-a3b
MODEL_CRITIC=velocity/Qwen3.6-35B-A3B
MODEL_CONSOLIDATOR=velocity/Qwen3.6-35B-A3B-nothink
MODEL_FALLBACK=velocity/DeepSeek-V4-Flash

# --- Поведение ---
# Timeout за едно извикване към модел, в секунди
REQUEST_TIMEOUT_SECONDS=120
# Брой опити при ModelUnavailableError, преди fallback модел
MODEL_MAX_RETRIES=3
# Брой опити за поправка при невалиден структуриран изход (InvalidResponseError)
INVALID_RESPONSE_MAX_RETRIES=2
