# Копирайте на .env и попълнете. Никога не commit-вайте .env.

# --- Open WebUI (OpenAI-съвместим endpoint) ---
OPENWEBUI_BASE_URL=https://chat.velocity.online/api/v1
OPENWEBUI_API_KEY=

# --- Модели по роля ---
# Потвърдени от потребителя 2026-08-10. Планер и Критик СЪЗНАТЕЛНО ползват същия модел
# (виж agent-bootstrap-prompt.md) — разликата между ролите е в промпта, не в модела.
MODEL_PLANNER=velocity/Qwen3.6-35B-A3B
MODEL_WRITER=m3.m3/qwen3.5-397b-a17b
# 2026-10-13: m2 (LM Studio) остана без зареден модел (400) — velocity/Qwen3.6-35B-A3B вижда снимки, проверено на живо.
MODEL_MEDIA=velocity/Qwen3.6-35B-A3B
MODEL_CRITIC=velocity/Qwen3.6-35B-A3B
# MODEL_CONSOLIDATOR вече НЕ е "nothink" вариант: от 2026-08-11 Консолидаторът обединява
# два поста в официално предложение (виж docs/technical/process-3.md) — това е писателска
# преценка, не форматиране, и слаб модел тук изяжда качеството на цялата верига.
MODEL_CONSOLIDATOR=m3.m3/qwen3.5-397b-a17b
MODEL_FALLBACK=velocity/DeepSeek-V4-Flash

# --- Поведение ---
# Timeout за едно извикване към модел, в секунди. 300, не 120: без стрийминг целият отговор
# трябва да дойде навреме, а Критикът мери 114–140s (research-plan-36, А8).
REQUEST_TIMEOUT_SECONDS=300
# Брой опити при ModelUnavailableError, преди fallback модел
MODEL_MAX_RETRIES=3
# Брой опити за поправка при невалиден структуриран изход (InvalidResponseError)
INVALID_RESPONSE_MAX_RETRIES=2

# --- Параметри на извадката (незадължителни) ---
# Празна стойност значи „не се изпраща в заявката" — тоест точно поведението, с което
# сегашната верига е измерена на 20 реални пускания. Виж план 11, находка 2.7.
#
# SEED е важен при мерене: без него две пускания със същия бриф дават различен текст и
# сравнението „преди/след" мери шума от извадката заедно с промяната. Задайте го, преди да
# правите базова линия с `python -m src.cli bench` (виж bench/README.md).
SEED=
# TEMPERATURE се ползва за кандидати с различна температура (process-4, Фаза 3). Оставете
# празно за нормална работа.
TEMPERATURE=
MAX_TOKENS=

# --- v5 (незадължително — research-plan-15-pipeline-speed-quality-rearchitecture.md) ---
# "v3" (подразбиране, оставете празно) не пипа нищо от сегашния конвейер. "v5" избира
# новата верига: факт-регистър → N кандидата паралелно → филтър за проследимост → съдия
# (избира, не пише) → форматиране → финална проверка асинхронно. Връщане назад е този ред.
PIPELINE_CHAIN=
# Брой паралелни кандидата в стъпка [2] на v5. Без значение при PIPELINE_CHAIN=v3.
WRITER_CANDIDATES=3
# Модел за ролята Съдия (v5). Празно → преизползва MODEL_CRITIC (виж src/llm/roles.py).
MODEL_JUDGE=

# --- Опционални ускорявания (research-plan-36, Б3/Б4) — изключени, докато не са измерени ---
# Пуснете `python -m src.cli spike`: показва дали сървърът ги поддържа и колко секунди пестят.
# Роли без скрити разсъждения ("мислене"), разделени със запетая, напр. planner,judge
# media е измерено на живо (2026-10-13): 8 снимки за ~5 s вместо 218 s, същите решения —
# Media Picker праща всяка снимка отделно, а при отделна снимка мисленето не помага.
# research-plan-38 (2026-10-14): planner,critic също — Планер ~9x и Критик ~4x по-бързи, сходни
# находки на едни и същи чернови. Понякога зациклят → таван NO_THINKING_TIMEOUT_SECONDS и резервен модел.
NO_THINKING_ROLES=media
# Таван (s) за роля без мислене, после резервният модел. Нормален отговор: 5-44 s.
NO_THINKING_TIMEOUT_SECONDS=90
# След финалната проверка агентът сам маха недоказаните твърдения (стъпка [8]). 0 = само докладвай.
FINAL_AUTOFIX=1
# off | json_schema — сървърът гарантира валиден JSON (по-малко повторни опити)
STRUCTURED_OUTPUT=off

# --- Уеб интерфейс (python -m src.cli web / start_web.bat) ---
# Празно = само от този компютър (127.0.0.1). За достъп от други компютри: WEB_HOST=0.0.0.0
# и ЗАДЪЛЖИТЕЛНО парола; сложете сървъра зад HTTPS (nginx/Caddy), иначе паролата минава некриптирана.
WEB_HOST=
WEB_PORT=8765
WEB_PASSWORD=
# Колко поста пише агентът наведнъж (чат + график). Таванът е сървърът на моделите, не този
# компютър — всеки пост е отделен процес и праща свои заявки. Вдигайте постепенно (3 → 5 → 8).
WEB_MAX_JOBS=3
# HTTPS направо от сървъра (по желание): пътища до сертификат и ключ (PEM). Нужно за достъп от
# други компютри — браузърът позволява запис в папка на потребителя само по https или localhost.
WEB_TLS_CERT=
WEB_TLS_KEY=

# --- Публикуване в LinkedIn (docs/technical/web-ui-2.md) ---
# draft (подразбиране) — нищо не се изпраща; заявката се записва в output/linkedin-request.json.
# linkedin — истинско публикуване през Community Management API (след одобрен достъп, план 9).
PUBLISH_MODE=draft
# Токен с право w_organization_social (издава се от Super Admin на страницата през приложението).
LINKEDIN_ACCESS_TOKEN=
# Само числото от urn:li:organization:<число> на страницата на клъстера.
LINKEDIN_ORG_ID=
# Версия на API във формат YYYYMM (LinkedIn поддържа всяка версия около година).
LINKEDIN_VERSION=202509
# Кога изтича токенът (YYYY-MM-DD) — 7 дни преди това се вдига сигнал (токенът е за 60 дни, без refresh).
LINKEDIN_TOKEN_EXPIRES=

# --- Сигнали при проблем с публикуването (docs/technical/web-ui-3.md) ---
# Винаги се виждат в интерфейса („Сигнали“ в лявата колона). По избор — и навън:
# Teams или Slack „Incoming webhook“ адрес — праща {"text": "..."}.
ALERT_WEBHOOK_URL=
# Имейл през SMTP (напр. smtp.office365.com, порт 587).
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
